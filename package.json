{
  "name": "stablog",
  "version": "3.5.4",
  "type": "module",
  "description": "稳部落. 专业备份微blog, 老铁, 稳!",
  "repository": {
    "type": "git",
    "url": "https://github.com/YaoZeyuan/stablog"
  },
  "main": "dist/index.js",
  "bin": {
    "stablog": "dist/interface/cli/main.js"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "author": "姚泽源",
  "license": "MIT",
  "scripts": {
    "start": "electron dist/index.js --stablog-debug",
    "start-client": "cd ./client && pnpm start",
    "prod": "electron dist/index.js",
    "cli": "node dist/interface/cli/main.js",
    "watch": "pnpm clean:esm-stale && babel src --copy-files --watch --out-dir dist --verbose --source-maps --extensions \".ts,.tsx,.js,.jsx\"",
    "watch-less": "node script/watch-less.cjs",
    "clean:esm-stale": "node scripts/build/clean-esm-stale.cjs",
    "build": "pnpm rebuild-sqlite3 && pnpm build-dist && electron-builder --publish never",
    "debug-build": "pnpm build-dist && electron-builder --dir",
    "build-dist": "node script/build.cjs",
    "build-server": "pnpm clean:esm-stale && babel src --copy-files -d dist --verbose --extensions \".ts,.tsx,.js,.jsx\"",
    "tsc": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "pnpm tsc && cross-env NODE_ENV=production eslint src",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "eslint": "eslint src",
    "prettier-with-fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,less,css}\"",
    "postinstall": "electron-builder install-app-deps",
    "rebuild-sqlite3": "electron-rebuild -f -w better-sqlite3",
    "build-4-local": "electron-builder --publish never"
  },
  "config": {
    "forge": "./forge.config.js"
  },
  "build": {
    "productName": "稳部落",
    "appId": "stablog",
    "copyright": "@姚泽源",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/public/image/icon.png"
    },
    "mac": {
      "category": "stablog.app.category.type",
      "target": "dmg",
      "icon": "src/public/image/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@optique/core": "^1.2.0",
    "@optique/run": "^1.2.0",
    "archiver": "^8.0.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.21",
    "decode-html": "^2.0.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "fs-extra": "^11.4.0",
    "image-size": "^2.0.2",
    "json5": "^2.2.3",
    "jspdf": "^4.2.1",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "mozjpeg-js": "^3.3.1",
    "query-string": "^9.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "sharp": "^0.35.3",
    "shelljs": "^0.10.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@electron/rebuild": "^4.2.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@types/archiver": "^8.0.0",
    "@types/async": "^3.2.25",
    "@types/dotenv": "^8.2.3",
    "@types/fs-extra": "^11.0.4",
    "@types/image-size": "^0.8.0",
    "@types/jquery": "^4.0.1",
    "@types/json5": "2.2.0",
    "@types/knex": "^0.16.1",
    "@types/less": "^3.0.8",
    "@types/lodash": "^4.17.25",
    "@types/md5": "^2.3.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/request": "^2.48.13",
    "@types/request-promise": "^4.1.51",
    "@types/sharp": "^0.32.0",
    "@types/shelljs": "^0.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "atob": "^2.1.2",
    "babel-plugin-root-import": "^6.6.0",
    "btoa": "^1.2.1",
    "canvg": "^4.0.3",
    "dompurify": "^3.4.13",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "html2canvas": "^1.4.1",
    "jsdom": "^30.0.1",
    "less": "^4.8.1",
    "less-watch-compiler": "^1.19.9",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "watch": "^1.0.2"
  }
}
