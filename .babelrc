{
  "presets": [
    [
      "@babel/env",
      {
        "targets": {
          "node": "6.10"
        }
      }
    ],
    ["@babel/preset-react"],
    "@babel/typescript"
  ],
  // 不考虑文件体积, 全部编译
  "compact": false,
  "plugins": [
    [
      "babel-plugin-root-import",
      {
        "rootPathSuffix": "./",
        "rootPathPrefix": "~"
      }
    ]
  ]
}
